# Ansible Vault: local vault password and per-site encrypted lab credentials.
# Real password is ephemeral per ATD lab session (LABPASSPHRASE) — never commit these.
.vault_pass.txt
sites/mpls-sr-sp/group_vars/MPLS_SR_SP/vault.yml
sites/dci-sr-evpn/group_vars/DCI_SR_EVPN/vault.yml

# ANTA run output (catalogs + reports) - regenerated by `make verify_*`
sites/*/anta/

# Claude Code local (per-machine) settings
.claude/settings.local.json
